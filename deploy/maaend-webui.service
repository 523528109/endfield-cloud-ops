[Unit]
Description=MaaEnd Web Console (Endfield Cloud Ops)
After=network.target

[Service]
KillMode=process
Type=simple
User=maa
Group=maa
WorkingDirectory=/home/maa/maaend-webui
Environment=HOME=/home/maa
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/maa/venv/bin/python /home/maa/maaend-webui/webui.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
